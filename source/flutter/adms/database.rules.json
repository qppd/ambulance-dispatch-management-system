{
  "rules": {
    // ===========================================================================
    // AUTHORIZATION MODEL (see docs/security.md and test/database-rules)
    //
    // Roles: superAdmin, municipalAdmin, driver, citizen.
    //
    // GATE — most rules below start with this precondition:
    //   auth != null
    //   && the caller's /users record exists with isApproved === true
    //   && isActive === true
    // Rationale: a self-registered driver/municipalAdmin account is created
    // with isApproved === false and must not gain ANY access to municipal
    // data until an administrator approves it. Deactivated accounts lose
    // access immediately, not just at next login.
    //
    // The ONLY un-gated access is a user's own /users/{uid} record (needed
    // for registration and the sign-in/verification flow) and the public
    // /municipalities directory (needed by the pre-auth registration form).
    //
    // Municipality-scoped queries (e.g. /users orderByChild('municipalityId'))
    // cannot be authorized with child-level rules in RTDB — queries are
    // authorized at the queried location only. That is not a dead end:
    // the .read rule on /users inspects the query itself (query.orderByChild
    // and query.equalTo) and passes only when the query is pinned to the
    // caller's own municipality. Municipal admins therefore read /users
    // directly and can receive nothing but their own records.
    // ===========================================================================

    // ===========================================================================
    // USERS
    // ===========================================================================
    "users": {
      // Full /users collection.
      //   - super admin: unfiltered read (user management screens).
      //   - municipal admin: read ONLY when the query is pinned to its own
      //     municipality. Rules cannot filter rows, but RTDB lets a rule
      //     inspect the query itself, so the query must order by
      //     municipalityId AND equalTo the caller's own id. A bare read, a
      //     read ordered by something else, or equalTo any other municipality
      //     fails the rule and is denied outright.
      //   - Everyone else: no access here; individuals use /users/{uid}.
      // The caller's own municipalityId is additionally required to be
      // non-null, otherwise `query.equalTo === null` would match an
      // unbounded query from an admin record with no municipality and hand
      // back every user in the system.
      ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin' && root.child('users').child(auth.uid).child('municipalityId').val() !== null && query.orderByChild === 'municipalityId' && query.equalTo === root.child('users').child(auth.uid).child('municipalityId').val()))",
      ".indexOn": ["role", "municipalityId"],

      "$uid": {
        // Own profile (any account state — required by registration and the
        // sign-in flow) or super admin.
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin'))",

        // WRITE — authorization lives here because it cascades down to child
        // writes (e.g. /users/{uid}/isApproved), where sibling fields are not
        // visible to .validate rules.
        ".write": "auth != null && ( (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin') || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin' && data.exists() && newData.exists() && root.child('users').child(auth.uid).child('municipalityId').val() === data.child('municipalityId').val()) || (auth.uid === $uid && ( (!data.exists() && newData.hasChildren(['email', 'firstName', 'lastName', 'role', 'createdAt']) && newData.child('isActive').val() === true && (newData.child('role').val() === 'citizen' || newData.child('role').val() === 'driver' || newData.child('role').val() === 'municipalAdmin') && (newData.child('role').val() === 'citizen' || newData.child('isApproved').val() === false) && (newData.child('municipalityId').val() === null || root.child('municipalities').child(newData.child('municipalityId').val()).exists())) || (data.exists() && newData.exists() && newData.child('role').val() === data.child('role').val() && newData.child('isApproved').val() === data.child('isApproved').val() && newData.child('isActive').val() === data.child('isActive').val() && newData.child('municipalityId').val() === data.child('municipalityId').val() && newData.child('email').val() === data.child('email').val()) || (data.exists() && !newData.exists()) )) )",

        // Structural check on full-record writes (registration / provisioning).
        ".validate": "!newData.exists() || newData.hasChildren(['email', 'firstName', 'lastName', 'role', 'createdAt'])",

        // Identity/privilege fields. Self-registration may pick any valid
        // role except superAdmin (enforced in .write above); once the record
        // exists, only a super admin may change role or municipality.
        "role": {
          ".validate": "(newData.val() === 'superAdmin' || newData.val() === 'municipalAdmin' || newData.val() === 'driver' || newData.val() === 'citizen') && (!data.exists() || data.val() === newData.val() || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin'))"
        },
        "email": {
          ".validate": "!data.exists() || data.val() === newData.val() || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin')"
        },
        "municipalityId": {
          ".validate": "!data.exists() || data.val() === newData.val() || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin')"
        },
        // Approval and activation: super admin anywhere; municipal admin for
        // accounts in the admin's own municipality (the municipality check is
        // enforced by the $uid .write rule above, where the target record is
        // visible). Users can never approve or activate themselves because
        // their own .write branch requires these fields to stay unchanged.
        "isApproved": {
          ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val() || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin')))"
        },
        "isActive": {
          ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val() || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin')))"
        }
      }
    },

    // ===========================================================================
    // MUNICIPALITY USERS MIRROR (written by Cloud Function onUserProfileWritten)
    //
    // RETAINED, BUT NO LONGER REQUIRED BY THE APP. Municipal admins now read
    // /users directly through the query-pinned rule in the USERS block above,
    // which reads the source of truth instead of a copy. The mirror only ever
    // held data when the Cloud Function was deployed, and as a second copy it
    // could drift from /users — a deactivated driver could outlive its own
    // deactivation here.
    //
    // Left in place because the Cloud Function and the authorization tests
    // that cover it still exist in the repo. Clients still never write it.
    // If the mirror is dropped for good, remove this block, functions/users.js
    // and its export, and tests/database-rules/mirror-sync.test.mjs together.
    // ===========================================================================
    "municipality_users": {
      "$municipalityId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin' && root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId))",

        "$uid": {
          ".write": "false"
        }
      }
    },

    // ===========================================================================
    // CITIZEN PERSONAL DATA (emergency contacts, medical info, notification
    // prefs) — one bucket per signed-in citizen: /citizen/{uid}/...
    //
    // Owner-only by design. This bucket holds personal contact and medical
    // data, so it is deliberately NOT municipality-shared: no admin, driver or
    // other citizen may read or write it. Writes additionally require the
    // account to still be active, so deactivation cuts access immediately.
    // ===========================================================================
    "citizen": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('isActive').val() !== false",

        ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('isActive').val() !== false"
      }
    },

    // ===========================================================================
    // MUNICIPALITIES (directory — public read is required by the pre-auth
    // registration form; contains only LGU directory data, no personal data)
    // ===========================================================================
    "municipalities": {
      ".read": true,

      "$municipalityId": {
        // Super admin creates/updates/deletes; municipal admin may update
        // (not create, not delete) its own municipality record only.
        ".write": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin' && root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && data.exists() && newData.exists()))",

        ".validate": "!newData.exists() || (newData.child('id').val() === $municipalityId && newData.hasChildren(['name', 'createdAt']))"
      }
    },

    // ===========================================================================
    // INCIDENTS
    // ===========================================================================
    "incidents": {
      // Super admin: system-wide analytics across all municipalities.
      ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin'",

      "$municipalityId": {
        ".indexOn": ["status", "assignedDriverId", "reporterId", "severity", "createdAt"],

        // Municipal admin + assigned drivers of this municipality. Citizens
        // are intentionally NOT covered here — they read single incidents
        // through the reporter check below (RTDB grants a read if the rule at
        // the accessed location OR any ancestor allows it).
        ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && (root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin' || root.child('users').child(auth.uid).child('role').val() === 'driver')))",

        "$incidentId": {
          // Citizens may read incidents they reported.
          ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && data.child('reporterId').val() === auth.uid",

          // WRITE:
          //  - super admin: anything (including delete)
          //  - municipal admin of this municipality: create/update (no delete)
          //  - assigned driver of this municipality: update ONLY the incident
          //    already assigned to them (checked against the pre-write data,
          //    so drivers can never reassign incidents to themselves)
          //  - citizen: create-only, must be their own report, status pending
          ".write": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && ( root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin' && root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && newData.exists()) || (root.child('users').child(auth.uid).child('role').val() === 'driver' && root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && data.exists() && newData.exists() && data.child('assignedDriverId').val() === auth.uid) || (root.child('users').child(auth.uid).child('role').val() === 'citizen' && !data.exists() && newData.child('reporterId').val() === auth.uid && newData.child('municipalityId').val() === $municipalityId && newData.child('status').val() === 'pending') )",

          // Full-record writes (creation) must carry the required fields and
          // be keyed correctly. Partial updates do not trigger this rule.
          ".validate": "!newData.exists() || (newData.hasChildren(['id', 'municipalityId', 'latitude', 'longitude', 'severity', 'status', 'createdAt']) && newData.child('id').val() === $incidentId && newData.child('municipalityId').val() === $municipalityId)",

          "id": {
            ".validate": "!data.exists() || data.val() === newData.val()"
          },
          "municipalityId": {
            ".validate": "!data.exists() || data.val() === newData.val()"
          },
          "createdAt": {
            ".validate": "!data.exists() || data.val() === newData.val()"
          },
          "reporterId": {
            ".validate": "!data.exists() || data.val() === newData.val()"
          },

          // LINEAR LIFECYCLE ENFORCEMENT (authoritative, applies to every
          // client including admins):
          //   pending -> acknowledged -> dispatched -> enRoute -> onScene
          //           -> transporting -> atHospital -> resolved
          // 'cancelled' may be entered from any active (non-terminal) state.
          // 'resolved' and 'cancelled' are terminal — no status may ever
          // change once set. Super admins may override transitions.
          "status": {
            ".validate": "(!data.exists() && (newData.val() === 'pending' || newData.val() === 'acknowledged')) || (data.exists() && ( newData.val() === data.val() || (data.val() === 'pending' && (newData.val() === 'acknowledged' || newData.val() === 'cancelled')) || (data.val() === 'acknowledged' && (newData.val() === 'dispatched' || newData.val() === 'cancelled')) || (data.val() === 'dispatched' && (newData.val() === 'enRoute' || newData.val() === 'cancelled')) || (data.val() === 'enRoute' && (newData.val() === 'onScene' || newData.val() === 'cancelled')) || (data.val() === 'onScene' && (newData.val() === 'transporting' || newData.val() === 'cancelled')) || (data.val() === 'transporting' && (newData.val() === 'atHospital' || newData.val() === 'cancelled')) || (data.val() === 'atHospital' && (newData.val() === 'resolved' || newData.val() === 'cancelled')) || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin') ))"
          }
        }
      }
    },

    // ===========================================================================
    // USER INCIDENT INDEX (citizen -> own incident ids)
    // ===========================================================================
    "user_incidents": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin'))",
        ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin'))",

        "$incidentId": {
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },

    // ===========================================================================
    // INCIDENT INDEX (incidentId -> municipalityId, created atomically with
    // the incident; immutable afterwards; value must reference a real
    // municipality so the index cannot be poisoned with bogus mappings)
    // ===========================================================================
    "incident_index": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true",

      "$incidentId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && newData.isString() && root.child('municipalities').child(newData.val()).exists() && (!data.exists() || newData.val() === data.val())"
      }
    },

    // ===========================================================================
    // UNITS (ambulances)
    // ===========================================================================
    "units": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin'",

      "$municipalityId": {
        ".indexOn": ["status", "assignedDriverId", "currentIncidentId"],

        ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && (root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin' || root.child('users').child(auth.uid).child('role').val() === 'driver')))",

        "$unitId": {
          // Super admin: all units. Municipal admin: create/update/delete
          // within own municipality. Driver: create/update (never delete) the
          // unit they are assigned to — used for status and location updates.
          ".write": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && ( root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin' && root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId) || (root.child('users').child(auth.uid).child('role').val() === 'driver' && root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && data.exists() && newData.exists() && data.child('assignedDriverId').val() === auth.uid) )",

          // Creation must be keyed correctly; existing units can be fully
          // rewritten (partial updates skip this rule).
          ".validate": "!newData.exists() || data.exists() || (newData.child('id').val() === $unitId && newData.child('municipalityId').val() === $municipalityId)",

          "id": {
            ".validate": "!data.exists() || data.val() === newData.val()"
          },
          "municipalityId": {
            ".validate": "!data.exists() || data.val() === newData.val()"
          },
          // Administrative fields: drivers may not rename or re-key their
          // unit, and only admins may change assignment.
          "callSign": {
            ".validate": "!data.exists() || data.val() === newData.val() || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin'))"
          },
          "assignedDriverId": {
            ".validate": "!data.exists() || data.val() === newData.val() || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin'))"
          },
          "assignedDriverName": {
            ".validate": "!data.exists() || data.val() === newData.val() || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin'))"
          }
        }
      }
    },

    // ===========================================================================
    // DRIVER-UNIT INDEX (/driver_units/{driverUid} -> "{muni}/{unitId}")
    // Write-only index maintained by unit assignment. The municipality is
    // encoded inside the string value and cannot be validated here, so this
    // node is restricted to admins; the corresponding unit assignment itself
    // remains municipality-scoped through /units.
    // ===========================================================================
    "driver_units": {
      "$driverUid": {
        ".read": "auth != null && (auth.uid === $driverUid || (root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin'))",
        ".write": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin')",
        ".validate": "!newData.exists() || newData.isString()"
      }
    },

    // ===========================================================================
    // MAINTENANCE
    // ===========================================================================
    "maintenance": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin'",

      "$municipalityId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin'))",

        "$maintenanceId": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin'))"
        }
      }
    },

    // ===========================================================================
    // PATIENT REPORTS (ePCR — most sensitive data in the system)
    // ===========================================================================
    "patient_reports": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin'",

      "$municipalityId": {
        ".indexOn": ["incidentId"],

        // Only approved staff of the owning municipality.
        ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && (root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin' || root.child('users').child(auth.uid).child('role').val() === 'driver')))",

        "$reportId": {
          // Drivers create/update reports for their own municipality (no
          // delete); municipal admins manage reports; super admin all.
          ".write": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && ( root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin') || (root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && root.child('users').child(auth.uid).child('role').val() === 'driver' && newData.exists()) )"
        }
      }
    },

    // ===========================================================================
    // AUDIT LOG — written exclusively by Cloud Functions (admin SDK bypasses
    // rules); readable by admins.
    // ===========================================================================
    "auditLog": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin')",
      ".indexOn": ["timestamp"],

      "$entryId": {
        ".write": "false"
      }
    },

    // ===========================================================================
    // SYSTEM CONFIG
    // ===========================================================================
    "systemConfig": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && root.child('users').child(auth.uid).child('role').val() === 'superAdmin'"
    },

    // ===========================================================================
    // INVITES — created by municipal admins for their own municipality;
    // consumed/marked by Cloud Functions (admin SDK).
    // ===========================================================================
    "invites": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin')",

      "$token": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin')",

        ".write": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin' && !data.exists() && newData.child('municipalityId').val() === root.child('users').child(auth.uid).child('municipalityId').val()))",

        ".validate": "!newData.exists() || newData.hasChildren(['email', 'role', 'municipalityId', 'createdAt'])"
      }
    },

    // ===========================================================================
    // DRIVER LOCATIONS (legacy node; live location updates are written to
    // /units/{muni}/{unitId}/latitude|longitude by the assigned driver)
    // ===========================================================================
    "driver_locations": {
      "$municipalityId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && root.child('users').child(auth.uid).child('role').val() === 'municipalAdmin'))",

        "$unitId": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('isApproved').val() === true && root.child('users').child(auth.uid).child('isActive').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superAdmin' || (root.child('users').child(auth.uid).child('municipalityId').val() === $municipalityId && root.child('users').child(auth.uid).child('role').val() === 'driver' && root.child('units').child($municipalityId).child($unitId).child('assignedDriverId').val() === auth.uid))"
        }
      }
    }
  }
}
